rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'florin390@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isValidNewReservation(d) {
      return d.status == 'pending'
        && d.name is string && d.name.size() > 0 && d.name.size() < 100
        && d.phone is string && d.phone.size() > 4 && d.phone.size() < 30
        && d.email is string && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && d.service is string && d.service.size() > 0
        && d.zone is string
        && d.details is string && d.details.size() < 2000
        && d.token is string && d.token.size() >= 24
        && d.createdAt == request.time;
    }

    match /reservations/{reservationId} {
      // Anyone can submit a new booking request (used by the public site).
      // They can never read it back directly - that only happens through
      // the getReservation Cloud Function, which checks the secret token.
      allow create: if isValidNewReservation(request.resource.data);

      // Only the signed-in admin can list/read/update/delete reservations.
      allow read, update, delete: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
